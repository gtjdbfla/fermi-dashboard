# 이 파일을 .env로 복사해서 채운다. .env는 git에 올리지 않는다.

# SEC EDGAR는 자동 요청에 연락처가 담긴 User-Agent를 요구한다.
# 없거나 형식이 어긋나면 403으로 막혀 대시보드가 통째로 비어 보인다.
SEC_USER_AGENT=fermi-dashboard/1.0 (your-email@example.com)

# 뉴스·소문 탭의 AI 정리에 쓴다. 없으면 그 부분만 비고 나머지는 정상 동작한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 즉시 알림과 일일 리포트가 쓴다. deploy.sh도 배포가 실패했을 때 같은 통로로 보낸다.
# 비워두면 알림만 꺼지고 나머지는 정상 동작한다.
# 주의: cheongyak-dashboard의 watcher가 이 파일을 --env-file로 그대로 공유해 쓴다.
# Fermi 쪽만 끄려면 토큰을 지우지 말고 아래 FERMI_ALERTS_DISABLED를 쓸 것.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 등으로 아무 값이나 채우면 토큰이 있어도 Fermi 쪽 전송(deploy 실패 알림·일일
# 리포트·즉시 알림)만 꺼진다. cheongyak watcher는 이 변수를 보지 않으므로 영향 없다.
FERMI_ALERTS_DISABLED=

# 알림 본문에 붙는 대시보드 링크. 없으면 링크만 빠진다.
DASHBOARD_URL=
